NODE_ENV=development
LOG_LEVEL=debug
APP_VERSION=2023-10-30
CORS_ORIGIN=http://localhost:3000

API_HOST=0.0.0.0
API_PORT=5003

# PostgreSQL database connection info
DB_HOST=replace.me
DB_PORT=5432
# Optional: verify the server certificate (path to a CA bundle, and the name the certificate carries)
# DB_SSL_CA=
# DB_SSL_SERVERNAME=
DB_USER=replace.me
DB_PASSWORD=replace.me
DB_DATABASE=replace.me

# For file storage and access
S3_BUCKET=replace.me
AWS_ACCESS_KEY_ID=replace.me
AWS_SECRET_ACCESS_KEY=replace.me
# Optional, development only: lifetime of multipart part URLs in seconds (default and
# maximum 604800). Set it low (e.g. 60) to exercise the clients' expired-URL path.
# UPLOAD_PART_URL_TTL_SECONDS=
S3_REGION=replace.me

APPLE_CLIENT_ID=com.replace.me
APP_SECRET=replace.me
GOOGLE_CLIENT_ID=replace.me.apps.googleusercontent.com
# Comma-separated list: Play app-signing cert hash + upload-key cert hash (for locally-signed release builds)
ANDROID_RELEASE_HASH=android:apk-key-hash:replace.me,android:apk-key-hash:replace.me.too

# Passkeys (WebAuthn). The RP ID must be the web client's hostname (or a parent domain of it):
# `localhost` for a local client. The server only accepts ceremonies from https://<rp id> and
# the Android hashes above; WEBAUTHN_EXTRA_ORIGINS (comma-separated, ignored in production)
# adds the origin a local client actually runs on, so its http://localhost:<port> is accepted.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=bookplayer
WEBAUTHN_EXTRA_ORIGINS=http://localhost:3000

# Sender for verification emails (AWS SES, us-east-1; the address must be verified in SES)
MAILER_NAME=BookPlayer
MAILER_EMAIL=replace@me.com

# Only required to process webhook events from RevenueCat
REVENUECAT_HEADER=
REVENUECAT_API=
REVENUECAT_KEY=

# RevenueCat REST API v2 (used by SubscriptionService.isActive for negative-cache verification)
REVENUECAT_API_V2=https://api.revenuecat.com/v2
REVENUECAT_API_V2_KEY=
REVENUECAT_PROJECT_ID=
# RC internal entitlement object ids (e.g. entla0aca3f4af) -> tier. Find them at
# RC dashboard > Project > Entitlements (the "id", not the lookup key).
REVENUECAT_ENTITLEMENT_PRO=
REVENUECAT_ENTITLEMENT_PLUS=
REVENUECAT_ENTITLEMENT_LITE=

REDIS_ENV=bookplayer_
REDIS_URL=redis://127.0.0.1:6379

# Apple App Store Server API credentials (for Retention Messaging)
# Download Apple root certificates from https://www.apple.com/certificateauthority/
# and place them in the /certs directory
APPLE_APP_APPLE_ID=
APPLE_BUNDLE_ID=com.tortugapower.audiobookplayer
APPLE_ENVIRONMENT=Production
APPLE_DEFAULT_RETENTION_MESSAGE_ID=

# Sync operations audit log (see docs/sync-operations-audit-plan.md)
# Optional: absence is inert. Set ENABLED=true to record library mutations.
SYNC_AUDIT_ENABLED=false
SYNC_AUDIT_RETENTION_DAYS=90

# Web billing: Stripe Checkout + Customer Portal. Stripe is linked to RevenueCat by
# RevenueCat's Stripe app, which maps each purchase to client_reference_id (the
# account's RevenueCat App User ID, users.external_id). All optional: with no
# STRIPE_SECRET_KEY the /v1/billing routes answer 503 BILLING_UNAVAILABLE.
# Use a test-mode key (sk_test_...) anywhere but production.
# Outside production, with REVENUECAT_PROJECT_ID / REVENUECAT_API_V2_KEY empty,
# checkout skips the App Store / Google Play entitlement check (logged as a warning).
STRIPE_SECRET_KEY=
# Plan catalog for GET /v1/billing/plans; checkout and change-plan only accept these
# price ids. amount is in major units; plan_code matches the RevenueCat entitlement.
STRIPE_PLANS=[{"price_id":"price_1UTRy4JxLIJ2ZVfyexuMvsK8","plan_code":"pro","name":"BookPlayer Pro (Web)","amount":4.99,"currency":"USD","interval":"month"},{"price_id":"price_1UTW1WJxLIJ2ZVfyxv5zOl3G","plan_code":"pro","name":"BookPlayer Pro (Web)","amount":49.99,"currency":"USD","interval":"year"},{"price_id":"price_1UTRzjJxLIJ2ZVfySlFfe7PN","plan_code":"lite","name":"BookPlayer Lite (Web)","amount":1.99,"currency":"USD","interval":"month"},{"price_id":"price_1UTVu2JxLIJ2ZVfyn0z2zD2q","plan_code":"lite","name":"BookPlayer Lite (Web)","amount":19.99,"currency":"USD","interval":"year"}]
# Tip catalog for GET /v1/billing/tips: one-time prices; tip_code matches the iOS
# tip jar (kind, excellent, incredible). Anyone may tip, signed in or not.
STRIPE_TIPS=[{"price_id":"price_1UTmlDJxLIJ2ZVfyiNdBloTL","tip_code":"kind","name":"Kind tip","amount":1.99,"currency":"USD"},{"price_id":"price_1UTmmEJxLIJ2ZVfyKjOwJ4cM","tip_code":"excellent","name":"Excellent tip","amount":4.99,"currency":"USD"},{"price_id":"price_1UTmmxJxLIJ2ZVfyhTCzbNFp","tip_code":"incredible","name":"Incredible tip","amount":9.99,"currency":"USD"}]
# Comma-separated origins (or app schemes like bookplayer:) that success_url, cancel_url
# and return_url may point to. http://localhost is also allowed outside production.
BILLING_RETURN_ORIGINS=https://web.bookplayer.app
# Optional: a Customer Portal configuration id (bpc_...); empty uses the default one.
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional: per-call Stripe timeout in ms (default 8000).
STRIPE_TIMEOUT_MS=
